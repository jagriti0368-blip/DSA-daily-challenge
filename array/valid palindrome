// Problem: valid palindrome
// Platform: Leetcode
// Time Complexity: O(3n)
// Space Complexity: O(1)
// Approach: 2 pointers

class Solution {
public:
    bool isPalindrome(string s) {
        int i=0;
        int j=s.size()-1;
        
        while(i<j){
            while(i<j && !isalnum(s[i])) {
               i++;
            }
             while(i<j && !isalnum(s[j])) {
               j--;
            }
           

           
            if(tolower(s[i])!=tolower(s[j])) return false;
            i++;
            j--;
        }
        return true;
        
    }
};
