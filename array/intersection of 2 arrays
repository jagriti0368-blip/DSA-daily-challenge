// Problem: intersection of 2 arrays
// Platform: Leetcode
// Time Complexity: O(n)
// Space Complexity: O(min(n,m))
// Approach: set


class Solution {
public:
    vector<int> intersection(vector<int>& nums1, vector<int>& nums2) {

        unordered_set<int> st(nums1.begin(), nums1.end());
        vector<int>ans;
        for (int x : nums2) {

            if (st.find(x) != st.end()) {
                ans.push_back(x);
                st.erase(x);
            }
        }
        return ans;
    }
};
