// Problem: Length of Last Word
// Platform: Leetcode
// Time Complexity: O(n)
// Space Complexity: O(1)
// Approach: nested if-else


class Solution {
public:
    int lengthOfLastWord(string s) {
        int i=s.size()-1;
        int count=0;
        while(i>=0){
            if(s[i]==' '){
                if(count>0){
                    break;
                }
            }
            else{
                count++;
            }
            i--;
        }
        return count;
    }
};
