// Problem: Happy Number
// Platform: Leetcode
// Time Complexity: O(log n)
// Space Complexity: O(1)
// Approach: slow and fast pointer

class Solution {
public:
    int nextNumber(int n) {
        int sum = 0;

        while (n > 0) {
            int digit = n % 10;
            sum += digit * digit;
            n /= 10;
        }

        return sum;
    }

    bool isHappy(int n) {
        int slow = n;
        int fast = n;

        do {
            slow = nextNumber(slow);
            fast = nextNumber(nextNumber(fast));
        } while (slow != fast);

        return slow == 1;
    }
};
