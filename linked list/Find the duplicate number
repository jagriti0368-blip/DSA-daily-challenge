// Problem: Find the duplicate number
// Platform: Leetcode
// Time Complexity: O(n)
// Space Complexity: O(1)
// Approach: fast and slow pointer


class Solution {
public:
    int findDuplicate(vector<int>& nums) {
        
        int slow = nums[0];
        int fast = nums[0];

        do {
            slow = nums[slow];
            fast = nums[nums[fast]];
        } while (slow != fast);

        slow = nums[0];

        while (slow != fast) {
            slow = nums[slow];
            fast = nums[fast];
        }

        return slow;
    }
};
