// Problem: Contiguous Array
// Platform: Leetcode
// Time Complexity: O(n)
// Space Complexity: O(n)
// Approach: prefix sum + map

class Solution {
public:
    int findMaxLength(vector<int>& nums) {
        map<int,int>mpp;
        int sum=0;
        mpp[0]=-1;
        int ans=0;
        for(int i=0 ; i<nums.size();i++){
            if(nums[i]==0) sum--;
            else{
                sum++;
            }
            if(mpp.find(sum)!=mpp.end()){
                ans=max(ans,i-mpp[sum]);
            }
            else{
                mpp[sum]=i;
            }
        }
        return ans;    
    }
};
